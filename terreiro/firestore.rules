rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /solicitacoes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /membros/{id} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
